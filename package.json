{
  "name": "corosim",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "publish:prep": "npm run build && node scripts/prepare-publish.mjs",
    "mcp": "tsx src/mcp/main.ts",
    "mcp:http": "tsx src/mcp/main.ts --http 8787",
    "build:mcp": "esbuild src/mcp/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-mcp/corosim-mcp.mjs --banner:js=\"import{createRequire as __corosimRequire}from'module';const require=__corosimRequire(import.meta.url);\"",
    "export:tools": "tsx scripts/export-tools.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "three": "^0.170.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
